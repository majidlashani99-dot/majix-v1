generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum LedgerType {
  TASK_REWARD
  VIDEO_REWARD
  REFERRAL_REWARD
  BONUS
  PREDICTION_ENTRY
  PREDICTION_WIN
  PREDICTION_LOSS
  WITHDRAWAL
  WITHDRAWAL_REVERT
  ADMIN_ADJUSTMENT
  EVENT_REWARD
  ACHIEVEMENT_REWARD
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  REJECTED
}

enum TaskType {
  WATCH_VIDEO
  FOLLOW_TELEGRAM
  FOLLOW_X
  JOIN_CHANNEL
  VISIT_WEBSITE
  COMPLETE_ACTION
  DAILY_TASK
  REFERRAL_TASK
  CUSTOM
}

enum TaskStatus {
  AVAILABLE
  STARTED
  PENDING_VERIFICATION
  COMPLETED
  REJECTED
  EXPIRED
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id           String             @id @default(cuid())
  telegramId   String             @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  language     String             @default("en")
  country      String?
  role         Role               @default(USER)
  status       UserStatus         @default(ACTIVE)
  referralCode String             @unique
  xp           Int                @default(0)
  level        Int                @default(1)
  streak       Int                @default(0)
  isVerified   Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lastLoginAt  DateTime?
  referredById String?
  referredBy   User?              @relation("referrals", fields: [referredById], references: [id])
  referrals    User[]             @relation("referrals")
  wallet       Wallet?
  tasks        UserTask[]
  transactions WalletTransaction[]
  notifications Notification[]
  withdrawals  Withdrawal[]
}

model Wallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  currency         String              @default("MJX")
  availableBalance Int                 @default(0)
  lockedBalance    Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id])
  transactions     WalletTransaction[]
}

model WalletTransaction {
  id             String      @id @default(cuid())
  walletId       String
  userId         String
  type           LedgerType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  referenceType  String?
  referenceId    String?
  description    String
  status         TxStatus    @default(COMPLETED)
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  wallet         Wallet      @relation(fields: [walletId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Task {
  id               String     @id @default(cuid())
  title            String
  description      String
  type             TaskType
  reward           Int
  status           TaskStatus @default(AVAILABLE)
  startAt          DateTime?
  endAt            DateTime?
  maxCompletions   Int?
  cooldown         Int        @default(0)
  verificationType String     @default("SERVER")
  externalUrl      String?
  videoUrl         String?
  metadata         Json?
  createdAt        DateTime   @default(now())
  userTasks        UserTask[]
}

model UserTask {
  id          String     @id @default(cuid())
  userId      String
  taskId      String
  status      TaskStatus @default(AVAILABLE)
  progress    Int        @default(0)
  completedAt DateTime?
  user        User       @relation(fields: [userId], references: [id])
  task        Task       @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
}

model VideoSession {
  id            String    @id @default(cuid())
  userId        String
  taskId        String
  startedAt     DateTime  @default(now())
  lastHeartbeat DateTime  @default(now())
  watchProgress Int       @default(0)
  completedAt   DateTime?
  status        String    @default("ACTIVE")
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  amount      Int
  method      String
  destination String
  status      WithdrawalStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime         @default(now())
  processedAt DateTime?
  user        User             @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  category  String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Achievement {
  id             String @id @default(cuid())
  title          String
  description    String
  icon           String
  conditionType  String
  conditionValue Int
  reward         Int
  xpReward       Int
}

model Match {
  id          String       @id @default(cuid())
  providerId  String       @unique
  homeTeam    String
  awayTeam    String
  league      String
  kickoff     DateTime
  status      String       @default("UPCOMING")
  homeScore   Int?
  awayScore   Int?
  odds        Json?
  predictions Prediction[]
}

model Prediction {
  id              String    @id @default(cuid())
  userId          String
  matchId         String
  market          String
  selection       String
  stake           Int
  oddsAtPlacement Float
  potentialPayout Int
  result          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  settledAt       DateTime?
  match           Match     @relation(fields: [matchId], references: [id])

  @@index([userId, createdAt])
}

model DailyBonusClaim {
  id        String   @id @default(cuid())
  userId    String
  claimDate DateTime
  reward    Int
  createdAt DateTime @default(now())

  @@unique([userId, claimDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
}
